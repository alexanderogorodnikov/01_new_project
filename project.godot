[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="snowball"
3d_physics/layer_4="snow_surface"

[physics]

3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.72, 0.82, 0.92, 1)

[xr]

openxr/enabled=true
openxr/form_factor=0
openxr/view_configuration=1
openxr/reference_space=1
openxr/environment_blend_mode=1
openxr/foveation_level=0
openxr/foveation_dynamic=false
shaders/enabled=true
